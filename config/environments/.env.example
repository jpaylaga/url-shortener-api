#
# Sample stage file. Copy it to config/environments/.env.<stage>
# (for example .env.local for local runs, .env.prod for production).
# Every .env* file except *.example is git-ignored: never commit real values.
# A .env.<stage>.local file, if present, wins over .env.<stage>.
# A shell variable that is set, even to an empty value, wins over both:
# package and deploy from a clean shell (scripts/withStageEnv.sh unsets the
# runtime keys first).
# Values are parsed by the shell (lesgo-scripts and scripts/withStageEnv.sh):
# no spaces, no quotes, no inline comments. Keep comments on their own lines.
#

#
# Deploy time: read by serverless.yml from the shell, all required.
# lesgo-scripts (npm run deploy -- -s <stage>) and scripts/withStageEnv.sh export
# .env.<stage>.local when it exists, otherwise .env.<stage>, so a .local file
# must repeat these keys.
#

# Service name. The stack is <APP_NAME>-<stage> and the table <APP_NAME>-<stage>-urls.
# Keep the default to update an existing stack in place.
APP_NAME=url-shortener-api

# AWS region for the stack. No default: packaging fails when it is missing or empty.
AWS_APP_REGION=us-east-1

# true when a custom domain fronts the API and the execute-api URL should be off.
# No default: set it to the value the stage already uses.
AWS_APIGW_DISABLE_DEFAULT_ENDPOINT=false

#
# Runtime: copied into the Lambda environment (custom.dotenv.include).
#

# true echoes the whole request event in every response's _meta. Never true in production.
APP_DEBUG=false

# Base of every returned short link, without a trailing slash. Required:
# packaging fails and the shorten function refuses to load without it.
SHORT_URL_DOMAIN=https://short.example

# Comma-separated hosts whose URLs skip the DNS and reachability checks
# (subdomains included), no spaces (for example a.example,b.example).
# Use it for sites that block automated HEAD and GET requests.
BYPASS_URL_EXISTS_DOMAINS=
